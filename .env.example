# CLOSELLER 환경변수 예시 파일 (Req 21.1, 21.2)
# -----------------------------------------------------------------------------
# 사용법: 이 파일을 복사해 `.env`로 만들고 값을 채운다. `.env`는 .gitignore에 포함되어 커밋되지 않는다.
#
# [중요 - 보안 규칙 Req 21.4]
# 이 파일에는 실제 API Key나 AWS 자격 증명을 절대 넣지 않는다.
# 비밀값(SerpApi Key 등)은 AWS SSM Parameter Store SecureString에 저장하고,
# 여기에는 그 "파라미터 이름(경로)"만 적는다. 실제 Key 값은 적지 않는다.
# -----------------------------------------------------------------------------

# AWS 리전 (서울)
AWS_REGION=ap-northeast-2

# 호출 횟수 제한 (SerpApi 무료 한도 보호)
# 월간 전체 호출 상한
MONTHLY_CALL_LIMIT=200
# IP별 일일 호출 상한
IP_DAILY_LIMIT=5

# API Gateway 스로틀 설정 (허용 범위 1~10,000)
# 초당 요청 처리율
THROTTLE_RATE=2
# 순간 버스트 허용량
THROTTLE_BURST=5

# Mock 검색 모드 사용 여부 (true면 외부 SerpApi를 호출하지 않고 고정 MOCK 데이터 반환)
USE_MOCK_SEARCH=false

# SerpApi API Key가 저장된 SSM Parameter Store의 "파라미터 이름(경로)"
# 주의: 여기에 실제 Key 값을 적지 않는다. SSM SecureString 파라미터의 경로만 적는다.
SERP_API_KEY_SSM_PARAM=/closeller/serpapi/api-key

# 프론트엔드가 호출할 백엔드 API의 베이스 URL (배포 후 API Gateway 엔드포인트로 교체)
VITE_API_BASE_URL=https://your-api-id.execute-api.ap-northeast-2.amazonaws.com
